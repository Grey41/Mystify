{
    "manifest_version": 3,
    "name": "Mystify",
    "version": "0.5.8",
    "permissions": ["scripting", "storage"],
    "description": "Quality of life overlay for Mystera Legacy",
    "browser_specific_settings": {
        "gecko": {
            "id": "mystify@greyhope.uk",
            "data_collection_permissions": {
                "required": ["none"],
                "optional": []
            }
        }
    },
    "content_scripts": [
        {
            "matches": ["https://www.mysteralegacy.com/play/full.php", "https://www.mysteralegacy.com/play-ml/"],
            "js": ["content.js"],
            "run_at": "document_start"
        }, {
            "matches": ["https://www.mysteralegacy.com/play/full.php", "https://www.mysteralegacy.com/play-ml/"],
            "js": ["inject.js"],
            "run_at": "document_start",
            "world": "MAIN"
        }
    ],
    "icons": {
        "16": "icon16.png",
        "32": "icon32.png",
        "48": "icon48.png"
    }
}